---
import '../styles/global.css'
import StoreHydrator from '../components/react/StoreHydrator'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{title} · Santiago Beracochea</title>
  </head>
  <body class="min-h-screen">
    <StoreHydrator client:load />
    <main
      class="flex min-h-screen items-center justify-center bg-gradient-to-br from-sb-blue-deeper to-sb-blue p-6"
    >
      <div class="w-full max-w-md">
        <slot />
        <a
          href="/"
          class="mx-auto mt-5 block w-fit text-[13px] text-white/50 transition hover:text-white"
        >
          ← Volver al inicio
        </a>
      </div>
    </main>
  </body>
</html>