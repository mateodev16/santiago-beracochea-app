---
import BaseLayout from '../layouts/BaseLayout.astro'
import CheckoutForm from '../components/react/CheckoutForm'
---

<BaseLayout title="Checkout">
  <section class="border-b border-slate-100 bg-sb-cream">
    <div class="mx-auto max-w-7xl px-6 py-14">
      <nav class="text-xs text-sb-muted">
        <a href="/catalogo" class="hover:text-sb-blue">Catálogo</a>
        <span class="mx-2">/</span>
        <span class="font-semibold text-sb-blue">Checkout</span>
      </nav>
      <h1 class="mt-4 font-display text-4xl font-bold text-sb-blue-deeper lg:text-5xl">
        Finalizar compra
      </h1>
      <p class="mt-3 max-w-2xl text-sb-muted">
        Completá tus datos de entrega y pago para registrar el pedido.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-12">
    <CheckoutForm client:load />
  </section>
</BaseLayout>