{
  "name": "santiago-beracochea-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "astro dev",
    "dev:api": "node --env-file=.env --watch server/index.js",
    "start": "node --env-file=.env server/index.js",
    "build": "astro build",
    "preview": "node --env-file=.env server/index.js",
    "check": "astro check",
    "db:migrate": "node --env-file=.env scripts/migrate-json-to-postgres.mjs",
    "db:setup": "node --env-file=.env scripts/setup-database.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.13.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.5",
    "playwright": "^1.63.0",
    "typescript": "^5.7.0"
  }
}
