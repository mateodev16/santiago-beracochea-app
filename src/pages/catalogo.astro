---
import BaseLayout from '../layouts/BaseLayout.astro'
import CatalogExplorer from '../components/react/CatalogExplorer'
---

<BaseLayout title="Catálogo" description="Explorá el catálogo completo de Santiago Beracochea.">
  <section class="border-b border-slate-100 bg-sb-cream">
    <div class="mx-auto max-w-7xl px-6 py-14">
      <nav class="text-xs text-sb-muted">
        <a href="/" class="hover:text-sb-blue">Inicio</a>
        <span class="mx-2">/</span>
        <span class="font-semibold text-sb-blue">Catálogo</span>
      </nav>
      <h1 class="mt-4 font-display text-4xl font-bold text-sb-blue-deeper lg:text-5xl">
        Catálogo de productos
      </h1>
      <p class="mt-3 max-w-2xl text-sb-muted">
        Filtrá por categoría, marca o precio y armá tu pedido. El carrito se actualiza al
        instante y podés confirmarlo desde el checkout.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-12">
    <CatalogExplorer client:load />
  </section>
</BaseLayout>