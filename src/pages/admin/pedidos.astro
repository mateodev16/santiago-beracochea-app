---
import BaseLayout from '../../layouts/BaseLayout.astro'
import AdminTabs from '../../components/AdminTabs.astro'
import AdminPanel from '../../components/react/AdminPanel'
---

<BaseLayout title="Pedidos de clientes · Panel administrativo">
  <section class="bg-sb-blue-deeper text-white">
    <div class="mx-auto max-w-7xl px-6 py-14">
      <nav class="text-xs text-white/60">
        <a href="/" class="hover:text-white">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/admin" class="hover:text-white">Panel administrativo</a>
        <span class="mx-2">/</span>
        <span class="font-semibold text-sb-gold">Pedidos de clientes</span>
      </nav>
      <h1 class="mt-4 font-display text-4xl font-bold lg:text-5xl">Pedidos de clientes</h1>
      <p class="mt-3 max-w-2xl text-white/70">
        Mirá todo lo que piden tus clientes y actualizá el estado de cada pedido.
      </p>

      <AdminTabs active="pedidos" />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-12">
    <AdminPanel view="pedidos" client:only="react" />
  </section>
</BaseLayout>