---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProductPurchase from '../../components/react/ProductPurchase'
import ProductCard from '../../components/react/ProductCard'
import { PRODUCTS, getProductBySlug } from '../../data/products'

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({ params: { slug: product.slug } }))
}

const { slug } = Astro.params
const product = getProductBySlug(slug)

if (!product) {
  return Astro.redirect('/catalogo')
}

const related = PRODUCTS.filter(
  (item) => item.category === product.category && item.id !== product.id,
).slice(0, 3)
---

<BaseLayout title={product.name} description={product.description}>
  <section class="mx-auto max-w-7xl px-6 py-12">
    <nav class="text-xs text-sb-muted">
      <a href="/" class="hover:text-sb-blue">Inicio</a>
      <span class="mx-2">/</span>
      <a href="/catalogo" class="hover:text-sb-blue">Catálogo</a>
      <span class="mx-2">/</span>
      <a href={`/catalogo?categoria=${encodeURIComponent(product.category)}`} class="hover:text-sb-blue">
        {product.category}
      </a>
    </nav>

    <div class="mt-8 grid gap-12 lg:grid-cols-2">
      <div class="relative rounded-3xl bg-sb-cream p-10">
        <img
          src={product.image}
          alt={product.name}
          class="mx-auto h-80 w-full object-contain lg:h-96"
        />
        {
          product.badge && (
            <span class="absolute top-6 left-6 rounded-full bg-sb-blue px-4 py-1.5 text-xs font-semibold tracking-wide text-white uppercase">
              {product.badge}
            </span>
          )
        }
      </div>

      <div class="flex flex-col gap-6">
        <div>
          <p class="text-xs font-bold tracking-[0.2em] text-sb-blue uppercase">{product.brand}</p>
          <h1 class="mt-3 font-display text-4xl leading-tight font-bold text-sb-blue-deeper">
            {product.name}
          </h1>
          <p class="mt-4 text-sb-muted">{product.description}</p>
        </div>

        <ProductPurchase product={product} client:load />

        <dl class="grid gap-4 rounded-2xl border border-slate-100 bg-white p-6 shadow-sm sm:grid-cols-2">
          <div>
            <dt class="text-xs font-semibold tracking-wide text-sb-muted uppercase">Categoría</dt>
            <dd class="mt-1 font-semibold text-sb-blue-deeper">{product.category}</dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-sb-muted uppercase">Presentación</dt>
            <dd class="mt-1 font-semibold text-sb-blue-deeper">{product.unit}</dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-sb-muted uppercase">Marca</dt>
            <dd class="mt-1 font-semibold text-sb-blue-deeper">{product.brand}</dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-sb-muted uppercase">Envío</dt>
            <dd class="mt-1 font-semibold text-sb-blue-deeper">Entrega en 24hs</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="mx-auto max-w-7xl px-6 pb-20">
        <h2 class="mb-8 font-display text-2xl font-bold text-sb-blue-deeper">
          También te puede interesar
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((item) => (
            <ProductCard product={item} client:visible />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>