---
import BaseLayout from '../layouts/BaseLayout.astro'
import OrderHistory from '../components/react/OrderHistory'
---

<BaseLayout title="Mis pedidos">
  <section class="border-b border-slate-100 bg-sb-cream">
    <div class="mx-auto max-w-7xl px-6 py-14">
      <nav class="text-xs text-sb-muted">
        <a href="/" class="hover:text-sb-blue">Inicio</a>
        <span class="mx-2">/</span>
        <span class="font-semibold text-sb-blue">Mis pedidos</span>
      </nav>
      <h1 class="mt-4 font-display text-4xl font-bold text-sb-blue-deeper lg:text-5xl">
        Historial de pedidos
      </h1>
      <p class="mt-3 max-w-2xl text-sb-muted">
        Revisá el estado de tus compras, el detalle de cada pedido y el total invertido.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-12">
    <OrderHistory client:load />
  </section>
</BaseLayout>